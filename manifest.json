{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.3.2",
  "description": "__MSG_description__",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "activeTab",
    "clipboardWrite",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["json-viewer.js"],
      "css": ["json-viewer.css"]
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube-volume.js"],
      "css": ["youtube-volume.css"]
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube-volume-player.js"],
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["screenshot.html"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "action": {
    "default_title": "Dev Workbench",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "default_locale": "vi",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
